@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

## The public headers include <eve/eve.hpp> and the exported target links eve::eve, so EVE's own
## package has to be found before ours is usable.
find_dependency(eve)

include("${CMAKE_CURRENT_LIST_DIR}/@COPA_TARGETS_NAME@.cmake")

set(@COPA_LIBRARY_UPPER@_LIBRARIES @COPA_NAMESPACE@::@COPA_LIBRARY@)

check_required_components(@COPA_LIBRARY@)
